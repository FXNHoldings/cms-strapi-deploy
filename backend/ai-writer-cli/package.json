{
  "name": "fxn-ai-writer-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Generate articles with OpenAI or Anthropic and post them to Strapi as drafts",
  "bin": {
    "fxn-ai": "./generate-originfacts-posts.js",
    "fxn-site-post": "./generate-site-post.js",
    "fxn-nxt-bargains-post": "./generate-nxt-bargains-post.js",
    "fxn-fxnseo-post": "./generate-fxnseo-post.js",
    "fxn-tool-content": "./generate-fxnseo-tool-content.js",
    "fxn-nxtsmart-post": "./generate-nxtsmart-post.js"
  },
  "scripts": {
    "generate": "node generate-originfacts-posts.js",
    "generate:site-post": "node generate-site-post.js",
    "generate:nxt-bargains-post": "node generate-nxt-bargains-post.js",
    "generate:fxnseo-post": "node generate-fxnseo-post.js",
    "generate:tool-content": "node generate-fxnseo-tool-content.js",
    "generate:nxtsmart-post": "node generate-nxtsmart-post.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@extractus/article-extractor": "^8.1.0",
    "@fal-ai/client": "^1.4.0",
    "@inquirer/prompts": "^7.2.1",
    "dotenv": "^16.4.7",
    "node-html-markdown": "^2.0.0",
    "openai": "^6.45.0",
    "slugify": "^1.6.6",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "htmlparser2": "8.0.2"
  }
}
