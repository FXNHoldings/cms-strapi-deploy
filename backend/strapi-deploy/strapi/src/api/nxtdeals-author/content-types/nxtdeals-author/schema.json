{
  "kind": "collectionType",
  "collectionName": "nxtdeals_authors",
  "info": {
    "singularName": "nxtdeals-author",
    "pluralName": "nxtdeals-authors",
    "displayName": "NXT Deals · Author",
    "description": "Editorial authors for nxt.deals (E-E-A-T attribution)."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "role": {
      "type": "string",
      "maxLength": 120
    },
    "bio": {
      "type": "text",
      "maxLength": 2000
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sameAs": {
      "type": "json"
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::nxtdeals-post.nxtdeals-post",
      "mappedBy": "author"
    }
  }
}
