{
  "kind": "collectionType",
  "collectionName": "nxt_discount_authors",
  "info": {
    "singularName": "nxt-discount-author",
    "pluralName": "nxt-discount-authors",
    "displayName": "NXT Discount · Author",
    "description": "Editorial authors and researchers for NXT.Discount"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "role": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::nxt-discount-post.nxt-discount-post",
      "mappedBy": "author"
    }
  }
}
