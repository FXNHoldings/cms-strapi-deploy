{
  "kind": "collectionType",
  "collectionName": "menus",
  "info": {
    "singularName": "menu",
    "pluralName": "menus",
    "displayName": "Menu",
    "description": "Navigation menu links for frontend sites"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "location": {
      "type": "enumeration",
      "enum": ["header", "footer", "utility"],
      "default": "header",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "target": {
      "type": "enumeration",
      "enum": ["self", "blank"],
      "default": "self"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::menu.menu",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::menu.menu",
      "mappedBy": "parent"
    }
  }
}
