{
  "kind": "collectionType",
  "collectionName": "globalscholar_posts",
  "info": {
    "singularName": "globalscholar-post",
    "pluralName": "globalscholar-posts",
    "displayName": "GlobalScholar.one · Post",
    "description": "Articles published to the GlobalScholar.one WordPress site"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 255 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text", "maxLength": 1000 },
    "content": { "type": "richtext", "required": true },
    "coverImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "sourceUrl": { "type": "string", "maxLength": 500 },
    "legacyWpId": { "type": "integer", "unique": true },
    "legacyFeaturedImageUrl": { "type": "string" },
    "seoTitle": { "type": "string", "maxLength": 70 },
    "seoDescription": { "type": "text", "maxLength": 160 },
    "source": {
      "type": "enumeration",
      "enum": ["manual", "wp-import", "ai", "csv-import"],
      "default": "manual"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::globalscholar-category.globalscholar-category",
      "inversedBy": "posts"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::globalscholar-author.globalscholar-author",
      "inversedBy": "posts"
    }
  }
}
