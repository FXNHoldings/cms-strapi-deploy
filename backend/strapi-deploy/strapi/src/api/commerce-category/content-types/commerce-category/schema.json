{
  "kind": "collectionType",
  "collectionName": "commerce_categories",
  "info": {
    "singularName": "commerce-category",
    "pluralName": "commerce-categories",
    "displayName": "Commerce · Category",
    "description": "Shared product taxonomy for commerce products."
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 120 },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "description": { "type": "text" },
    "order": { "type": "integer", "default": 0 },
    "icon": { "type": "string", "maxLength": 40 },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::commerce-category.commerce-category",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::commerce-category.commerce-category",
      "mappedBy": "parent"
    },
    "categoryStatus": {
      "type": "enumeration",
      "enum": ["active", "inactive"],
      "default": "active",
      "required": true
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::commerce-product.commerce-product",
      "mappedBy": "categories"
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::commerce-site.commerce-site",
      "inversedBy": "categories",
      "description": "Which storefronts show this category. Until now nothing on a category said who owned it, so ownership was inferred from the products inside it — which broke as soon as a category was empty, and could not be shown as a column in the admin list. commerce-site.enabledCategories holds the same idea as free-text slugs, editable only from the Site side and silently wrong on a typo; this is the same link as a real relation, editable from either side."
    }
  }
}
