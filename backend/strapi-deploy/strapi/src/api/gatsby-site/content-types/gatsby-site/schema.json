{
  "kind": "collectionType",
  "collectionName": "gatsby_sites",
  "info": {
    "singularName": "gatsby-site",
    "pluralName": "gatsby-sites",
    "displayName": "Gatsby · Site",
    "description": "Site tag for routing shared Gatsby content to one or more sites"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 60,
      "description": "Machine key used by the Gatsby build filter, e.g. indepthdaily"
    },
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "domain": {
      "type": "string",
      "maxLength": 120
    },
    "posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::gatsby-post.gatsby-post",
      "mappedBy": "sites"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::gatsby-category.gatsby-category",
      "mappedBy": "sites"
    }
  }
}
