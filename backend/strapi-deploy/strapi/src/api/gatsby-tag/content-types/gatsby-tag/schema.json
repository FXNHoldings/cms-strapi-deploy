{
  "kind": "collectionType",
  "collectionName": "gatsby_tags",
  "info": {
    "singularName": "gatsby-tag",
    "pluralName": "gatsby-tags",
    "displayName": "Gatsby · Tag",
    "description": "Tags for the Gatsby FlexiBlog starter website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 60
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::gatsby-post.gatsby-post",
      "mappedBy": "tags"
    }
  }
}
