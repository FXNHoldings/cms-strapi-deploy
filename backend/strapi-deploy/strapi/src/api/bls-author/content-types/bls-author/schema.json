{
  "kind": "collectionType",
  "collectionName": "bls_authors",
  "info": {
    "singularName": "bls-author",
    "pluralName": "bls-authors",
    "displayName": "BLS · Author",
    "description": "WordPress authors for BestLooking.Skin"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 120 },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "bio": { "type": "text", "maxLength": 2000 },
    "legacyWpId": { "type": "integer", "unique": true },
    "avatarUrl": { "type": "string" },
    "posts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bls-post.bls-post",
      "mappedBy": "author"
    }
  }
}
